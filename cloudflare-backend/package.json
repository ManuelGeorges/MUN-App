{
  "name": "mianu-cloudflare-backend",
  "version": "1.0.0",
  "description": "MIANU Conference backend on Cloudflare Workers and D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:local:schema": "wrangler d1 execute mianu-org-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:local:seed": "wrangler d1 execute mianu-org-db --local --file=./migrations/0002_seed_data.sql",
    "d1:remote:schema": "wrangler d1 execute mianu-org-db --remote --file=./migrations/0001_initial_schema.sql",
    "d1:remote:seed": "wrangler d1 execute mianu-org-db --remote --file=./migrations/0002_seed_data.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.131.0"
  }
}
